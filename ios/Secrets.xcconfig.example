// Copy this file to Secrets.xcconfig (gitignored) and fill in real values
// from the wizard's setup steps. None of these are sensitive secrets in
// the "must never leak" sense — the Supabase anon key is safe to ship
// client-side (protected by RLS), and Sentry DSNs / TelemetryDeck app IDs
// are meant to be public — this is kept out of git purely so per-developer
// / per-environment values don't churn the repo.
//
// xcconfig treats an unescaped "//" as a comment, which breaks URLs — the
// "$()" (empty build setting) below splits the slashes so Xcode doesn't
// treat the rest of the line as a comment. It expands to nothing at build
// time, so the substituted value is a normal URL.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
SENTRY_DSN = https:/$()/publicKey@o0.ingest.sentry.io/0
TELEMETRYDECK_APP_ID = 00000000-0000-0000-0000-000000000000
