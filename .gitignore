# macOS
.DS_Store

# Claude Code session-local runtime state
.claude/

# Node (npx-fetched CLIs, any future tooling)
node_modules/

# Xcode / XcodeGen — the .xcodeproj and Info.plist are generated from
# ios/project.yml (see ios/README.md), never hand-edited or committed.
ios/*.xcodeproj/
ios/WakeMate/Info.plist
ios/DerivedData/
ios/.build/
ios/**/xcuserdata/
ios/Secrets.xcconfig

# Fastlane's own local run artifacts (reports, logs) — the certificate/
# profile it manages live in the `certificates` git branch instead (see
# ios/fastlane/Matchfile), never here.
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots/
ios/fastlane/test_output/

# Supabase CLI local state
supabase/.branches
supabase/.temp

# Setup wizard's captured values (DB password, access token, DSNs) — never
# committed, plaintext bookkeeping for local re-runs only.
.scratch/wake-mate/setup-wizard.env

# Apple App Store Connect API private key (.p8) — Apple only lets you
# download this once, so it gets saved locally for safekeeping, but it must
# never enter git history. Its base64 copy lives in setup-wizard.env above
# instead, for pushing to GitHub as a secret.
*.p8
